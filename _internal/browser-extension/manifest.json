{
  "manifest_version": 3,
  "name": "OF Saver Browser Connection",
  "version": "1.0.0",
  "description": "Connect the active OnlyFans session to your local OF Saver profile after explicit approval.",
  "key": "",
  "permissions": [
    "activeTab",
    "cookies",
    "webRequest",
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://onlyfans.com/*",
    "https://www.onlyfans.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Connect to OF Saver",
    "default_popup": "popup.html"
  }
}